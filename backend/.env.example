# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<AppName>

# JWT Auth Secret (Generate one using: openssl rand -hex 32)
JWT_SECRET_KEY=your_super_secret_key_here

# LLM API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# CORS Configuration for Production
# Set this to your frontend URL in production (e.g. https://your-frontend.vercel.app)
# Use comma separation for multiple origins: https://frontend.com,http://localhost:5173
CORS_ORIGINS=*
